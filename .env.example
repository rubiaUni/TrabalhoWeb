# Copie para .env e ajuste se quiser. Todos tem default no docker-compose.yml.

# Porta do backend (API) no host
BACKEND_PORT=3000

# Porta do frontend no host
FRONTEND_PORT=5173

# Caminho base da API usado pelo browser (same-origin, via proxy do Vite).
# Normalmente nao precisa mudar.
VITE_API_URL=/api

# URL pública do frontend — usada para gerar o QR Code.
# Para testar no celular, troque por http://<seu-ip-local>:5173
FRONTEND_URL=http://localhost:5173
