// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Notebook {
  id              String  @id @default(cuid())
  brand           String
  lineName        String?
  fullModel       String
  manufactureYear Int

  conditionGrade       String
  functionalityPercent Int
  conditionDescription String?

  batteryDesignMWh  Int?
  batteryCurrentMWh Int?
  autonomyMinHours  Float?
  autonomyMaxHours  Float?
  autonomyNote      String?

  osName    String?
  osLicense String?

  coverageMonths Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processor    Processor?
  ram          RamModule[]
  ramSummary   RamSummary?
  storages     StorageDevice[]
  graphicsCard GraphicsCard?
  display      Display?
  connectivity Connectivity?
  ports        Port[]
  extras       Extra[]
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Processor {
  id           String  @id @default(cuid())
  brand        String?
  model        String
  cores        Int?
  threads      Int?
  baseClockGhz Float?
  maxClockGhz  Float?

  notebookId String   @unique
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

model RamSummary {
  id                  String @id @default(cuid())
  totalGb             Int
  type                String
  currentFrequencyMhz Int?
  maxCapacityGb       Int?

  notebookId String   @unique
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

model RamModule {
  id         String  @id @default(cuid())
  slotLabel  String
  capacityGb Int?
  isEmpty    Boolean @default(false)

  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

model StorageDevice {
  id         String  @id @default(cuid())
  slotLabel  String
  type       String?
  capacityGb Int?
  isEmpty    Boolean @default(false)

  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

model GraphicsCard {
  id          String  @id @default(cuid())
  model       String
  vramGb      Int?
  isDedicated Boolean @default(true)

  notebookId String   @unique
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

model Display {
  id               String  @id @default(cuid())
  sizeInches       Float
  resolutionWidth  Int
  resolutionHeight Int
  panelType        String?
  refreshRateHz    Int?
  antiGlare        Boolean @default(false)

  notebookId String   @unique
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

model Connectivity {
  id               String  @id @default(cuid())
  wifiStandard     String?
  wifiBandGhz      String?
  webcamResolution String?

  notebookId String   @unique
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

model Port {
  id       String @id @default(cuid())
  type     String
  quantity Int    @default(1)

  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

model Extra {
  id          String @id @default(cuid())
  description String

  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}
