generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Notebook {
  id        Int      @id @default(autoincrement())
  brand     String
  model     String
  timestamp DateTime @default(now())

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  cpuBrand       String?
  cpuModel       String?
  cpuCores       Int?
  cpuThreads     Int?
  ramGb          Int?
  ramType        String?
  storageGb      Int?
  storageType    String?
  gpuModel       String?
  gpuVramGb      Int?
  gpuDedicated   Boolean?
  displaySize    Float?
  displayRes     String?
  displayPanel   String?
  osName         String?
  osLicense      String?
  batteryMWh     Int?
  batteryHealth  Int?
  conditionDesc  String?
  coverageMonths Int?

  images NotebookImage[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  notebooks   Notebook[]
}

model NotebookImage {
  id         Int      @id @default(autoincrement())
  filename   String
  mimetype   String
  size       Int
  notebookId Int
  notebook   Notebook @relation(fields: [notebookId], references: [id])
  createdAt  DateTime @default(now())
}
